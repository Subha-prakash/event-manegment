{
  "name": "eventgenie-ai",
  "version": "1.0.0",
  "description": "EventGenie AI — GenAI-Powered Event Planning Assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/src/index.js",
    "serve": "node server/src/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/src/index.js",
    "client": "npm run --prefix client dev",
    "test": "node --test server/test/*.test.js",
    "test:unit": "node --test server/test/unit.test.js",
    "test:integration": "node --test server/test/integration.test.js",
    "test:client": "npm run --prefix client test",
    "test:all": "npm run test:client && npm run test",
    "build": "npm install --prefix client && npm run --prefix client build",
    "install:all": "npm install && npm run --prefix client install && npm run --prefix server install"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
