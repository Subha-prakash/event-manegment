# EventGenie AI — Environment Configuration

# Server Port
PORT=5000

# Optional Google Gemini API Key
# If omitted, EventGenie AI automatically operates using its built-in domain planning engine.
# Obtain a free key from https://aistudio.google.com
GEMINI_API_KEY=

# Supabase (Optional for Cloud Deployment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
